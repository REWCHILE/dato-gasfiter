# ==============================================================================
# REGLAS DE URLS LIMPIAS Y CANÓNICAS PARA DATO GASFITER
# ==============================================================================
RewriteEngine On
RewriteBase /

# 1. Redirección canónica 301 www -> non-www
RewriteCond %{HTTP_HOST} ^www\.dato-gasfiter\.cl$ [NC]
RewriteRule ^(.*)$ https://dato-gasfiter.cl/$1 [R=301,L]

# 2. Redirección canónica 301 de /index o /index.html hacia la raíz /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2b. Redirección 301 de gasfiter-emergencia-24-7 hacia gasfiter-emergencia-urgencias
RewriteRule ^gasfiter-emergencia-24-7(\.html)?$ /gasfiter-emergencia-urgencias [R=301,L]

# 3. Si se solicita cualquier otro archivo con extensión .html, redirigir a URL limpia (301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Reescribir internamente la URL limpia hacia el archivo .html existente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# 5. Seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
